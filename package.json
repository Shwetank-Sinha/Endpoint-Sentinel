{
  "name": "endpoint-sentinel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:browser": "node test/browser/qa.mjs",
    "test:jury": "node test/browser/jury-smoke.mjs",
    "test:visual": "node test/browser/qa.mjs --captures",
    "test:bundle": "node test/client-bundle-secrets.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.54.10",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260916.1",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.132.0"
  }
}
